<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Habit Chain - Your chain of consistent learning, all in one place. Centralized academic notes, question papers, and lab manuals.">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - Habit Chain' : 'Habit Chain - Your Chain of Consistent Learning' %></title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Google Fonts: Plus Jakarta Sans (Headings) & Inter (Body/UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Habit Chain Custom CSS -->
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>

  <!-- Header / Navigation -->
  <header>
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <%- include('../partials/logo') %>
        </a>
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" aria-controls="navContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
            <li class="nav-item">
              <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'semesters' ? 'active' : '' %>" href="/semesters">Semesters</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'lab' ? 'active' : '' %>" href="/lab">Lab Resources</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'question-papers' ? 'active' : '' %>" href="/question-papers">Question Papers</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'announcements' ? 'active' : '' %>" href="/announcements">Announcements</a>
            </li>
          </ul>
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
            <li class="nav-item">
              <a class="nav-link" href="/feedback">Feedback</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/contact">Contact</a>
            </li>
            <li class="nav-item ms-lg-2">
              <% if (typeof admin !== 'undefined' && admin) { %>
                <!-- Admin is logged in -->
                <a class="btn btn-primary btn-sm px-3" href="/admin/dashboard">
                  <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </a>
              <% } else if (typeof student !== 'undefined' && student) { %>
                <!-- Student is logged in: avatar dropdown -->
                <%
                  const _initials = student.name
                    ? student.name.split(' ').map(w => w[0]).join('').toUpperCase().slice(0,2)
                    : '?';
                  const _color = student.avatar_color || '#0F9D9A';
                %>
                <div class="dropdown">
                  <button class="btn btn-link p-0 border-0 d-flex align-items-center gap-2 text-decoration-none dropdown-toggle"
                    type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Student menu">
                    <span style="width:36px;height:36px;border-radius:50%;background:<%= _color %>;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:.85rem;font-family:var(--font-heading)">
                      <%= _initials %>
                    </span>
                    <span class="d-none d-lg-inline fw-medium" style="color:var(--color-text);font-size:.9rem"><%= student.name.split(' ')[0] %></span>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width:190px;border-radius:10px">
                    <li><h6 class="dropdown-header text-truncate" style="max-width:170px"><%= student.name %></h6></li>
                    <li><a class="dropdown-item" href="/student/dashboard"><i class="bi bi-house me-2"></i>Dashboard</a></li>
                    <li><a class="dropdown-item" href="/student/bookmarks"><i class="bi bi-bookmark-heart me-2"></i>Bookmarks</a></li>
                    <li><a class="dropdown-item" href="/student/profile"><i class="bi bi-person-circle me-2"></i>Profile</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <form method="POST" action="/logout" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="dropdown-item text-danger">
                          <i class="bi bi-box-arrow-right me-2"></i>Log Out
                        </button>
                      </form>
                    </li>
                  </ul>
                </div>
              <% } else { %>
                <!-- Guest: show login + signup buttons -->
                <div class="d-flex gap-2 align-items-center">
                  <a class="btn btn-outline-primary btn-sm px-3" href="/login">Log In</a>
                  <a class="btn btn-primary btn-sm px-3" href="/signup">Sign Up</a>
                </div>
              <% } %>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <!-- Alerts -->
  <div class="container mt-3">
    <% if (typeof messages !== 'undefined' && messages.error && messages.error.length > 0) { %>
      <% messages.error.forEach(function(msg) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% }); %>
    <% } %>

    <% if (typeof messages !== 'undefined' && messages.success && messages.success.length > 0) { %>
      <% messages.success.forEach(function(msg) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Main Content -->
  <main id="main-content" class="py-4">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="footer-custom mt-auto">
    <div class="container text-center text-md-start">
      <div class="row align-items-center gy-3">
        <div class="col-md-6 text-center text-md-start">
          <div class="d-inline-flex align-items-center mb-1">
            <%- include('../partials/logo') %>
          </div>
          <p class="text-secondary small mb-0 mt-1">Your chain of consistent learning, all in one place.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <ul class="list-inline mb-2">
            <li class="list-inline-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
            <li class="list-inline-item text-secondary">•</li>
            <li class="list-inline-item"><a href="/semesters" class="text-secondary text-decoration-none">Semesters</a></li>
            <li class="list-inline-item text-secondary">•</li>
            <li class="list-inline-item"><a href="/feedback" class="text-secondary text-decoration-none">Feedback</a></li>
            <li class="list-inline-item text-secondary">•</li>
            <li class="list-inline-item"><a href="/contact" class="text-secondary text-decoration-none">Contact Admin</a></li>
          </ul>
          <p class="text-secondary small mb-0">&copy; <%= new Date().getFullYear() %> Habit Chain. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
