<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Academic Resources</h2>
    <p class="text-muted mb-0">Browse, edit, and manage all learning materials, papers, and lab manuals</p>
  </div>
  <a href="/admin/resources/new" class="btn btn-primary">
    <i class="bi bi-cloud-arrow-up me-1"></i> Upload New Resource
  </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3 bg-white">
    <form method="GET" action="/admin/resources" class="row g-3 align-items-center">
      <div class="col-md-5">
        <label for="filterSub" class="form-label small text-muted mb-1">Subject</label>
        <select class="form-select" id="filterSub" name="subject_id" onchange="this.form.submit()">
          <option value="">-- All Subjects --</option>
          <% subjects.forEach(function(s) { %>
            <option value="<%= s.subject_id %>" <%= selectedSubjectId == s.subject_id ? 'selected' : '' %>>
              [<%= s.code %>] <%= s.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="filterType" class="form-label small text-muted mb-1">Resource Type</label>
        <select class="form-select" id="filterType" name="type_id" onchange="this.form.submit()">
          <option value="">-- All Types --</option>
          <% resourceTypes.forEach(function(t) { %>
            <option value="<%= t.type_id %>" <%= selectedTypeId == t.type_id ? 'selected' : '' %>>
              <%= t.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-3 d-flex align-items-end">
        <a href="/admin/resources" class="btn btn-outline-secondary w-100">Clear Filters</a>
      </div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (resources && resources.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Title & Format</th>
              <th>Subject / Module</th>
              <th>Type</th>
              <th>Size</th>
              <th>Downloads</th>
              <th>Uploaded</th>
              <th class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% resources.forEach(function(r) { %>
              <tr>
                <td class="ps-3">
                  <div class="fw-bold"><%= r.title %></div>
                  <span class="badge bg-light text-secondary border font-monospace small text-uppercase">
                    .<%= r.file_format %>
                  </span>
                  <span class="text-muted small ms-1"><%= r.original_filename %></span>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= r.subject_code %></div>
                  <div class="text-muted small">
                    <%= r.module_number ? 'Module ' + r.module_number : 'Subject Level' %>
                  </div>
                </td>
                <td>
                  <span class="badge badge-soft-primary"><%= r.type_name %></span>
                  <% if (r.exam_year) { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis ms-1"><%= r.exam_year %></span>
                  <% } %>
                </td>
                <td class="text-muted small">
                  <%= (r.file_size / (1024 * 1024)).toFixed(2) %> MB
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-download me-1"></i><%= r.download_count %>
                  </span>
                </td>
                <td class="text-muted small">
                  <%= new Date(r.uploaded_at).toLocaleDateString() %>
                </td>
                <td class="text-end pe-3">
                  <div class="d-flex justify-content-end gap-2">
                    <% if (r.file_format === 'pdf') { %>
                      <a href="/resources/<%= r.resource_id %>/view" target="_blank" class="btn btn-sm btn-outline-info" title="Preview PDF">
                        <i class="bi bi-eye"></i>
                      </a>
                    <% } %>
                    <a href="/resources/<%= r.resource_id %>/download" class="btn btn-sm btn-outline-secondary" title="Download">
                      <i class="bi bi-download"></i>
                    </a>
                    <a href="/admin/resources/<%= r.resource_id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/admin/resources/<%= r.resource_id %>/delete" method="POST" onsubmit="return confirm('Permanently delete <%= r.title %> and its file?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-4 text-center text-muted">
        <i class="bi bi-folder2-open fs-1 d-block mb-2"></i>
        <p class="mb-0">No resources match the selected criteria.</p>
      </div>
    <% } %>
  </div>
</div>

