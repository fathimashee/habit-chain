<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0"><%= isEdit ? 'Edit Subject' : 'Add New Subject' %></h5>
      </div>
      <div class="card-body p-4">
        <form action="<%= isEdit ? '/admin/subjects/' + subject.subject_id + '/edit' : '/admin/subjects/new' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="semester_id" class="form-label fw-semibold">Semester <span class="text-danger">*</span></label>
            <select class="form-select" id="semester_id" name="semester_id" required>
              <option value="">-- Select Semester --</option>
              <% semesters.forEach(function(s) { %>
                <option value="<%= s.semester_id %>" <%= subject.semester_id == s.semester_id ? 'selected' : '' %>>
                  <%= s.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label for="code" class="form-label fw-semibold">Subject Code <span class="text-danger">*</span></label>
            <input type="text" class="form-control text-uppercase font-monospace" id="code" name="code" required placeholder="e.g. BCA101, CS202" value="<%= subject.code || '' %>">
            <div class="form-text">Unique alphanumeric identifier within the semester.</div>
          </div>

          <div class="mb-3">
            <label for="name" class="form-label fw-semibold">Subject Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="name" name="name" required placeholder="e.g. Data Structures" value="<%= subject.name || '' %>">
          </div>

          <div class="mb-4">
            <label for="description" class="form-label fw-semibold">Description</label>
            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Brief subject overview or syllabus scope..."><%= subject.description || '' %></textarea>
          </div>

          <div class="d-flex justify-content-between">
            <a href="/admin/subjects" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-check-lg me-1"></i> <%= isEdit ? 'Update Subject' : 'Save Subject' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

