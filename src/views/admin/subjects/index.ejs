<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Subjects</h2>
    <p class="text-muted mb-0">Manage course subjects, academic codes, and semester associations</p>
  </div>
  <a href="/admin/subjects/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i> Add Subject
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (subjects && subjects.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Code</th>
              <th>Subject Name</th>
              <th>Semester</th>
              <th>Modules</th>
              <th>Resources</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(function(s) { %>
              <tr>
                <td class="ps-3">
                  <span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace"><%= s.code %></span>
                </td>
                <td class="fw-semibold">
                  <%= s.name %>
                  <% if (s.description) { %>
                    <div class="text-muted small text-truncate" style="max-width: 250px;"><%= s.description %></div>
                  <% } %>
                </td>
                <td><span class="badge bg-light text-dark border"><%= s.semester_name %></span></td>
                <td>
                  <a href="/admin/modules?subject_id=<%= s.subject_id %>" class="btn btn-sm btn-link p-0 text-decoration-none">
                    <%= s.module_count %> modules <i class="bi bi-arrow-right-short"></i>
                  </a>
                </td>
                <td><span class="badge bg-info-subtle text-info-emphasis"><%= s.resource_count %> published</span></td>
                <td>
                  <div class="d-flex gap-2">
                    <a href="/admin/subjects/<%= s.subject_id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/admin/subjects/<%= s.subject_id %>/delete" method="POST" onsubmit="return confirm('Delete subject <%= s.name %>? This will fail if it has uploaded resources.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-4 text-center text-muted">
        <p class="mb-0">No subjects created yet. Click "Add Subject" to define course units.</p>
      </div>
    <% } %>
  </div>
</div>

