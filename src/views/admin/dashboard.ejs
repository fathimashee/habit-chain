<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Dashboard Overview</h2>
    <p class="text-secondary mb-0">Platform summary and recent operational activity</p>
  </div>
  <div>
    <a href="/admin/resources/new" class="btn btn-primary">
      <i class="bi bi-cloud-arrow-up me-1"></i> Upload Resource
    </a>
  </div>
</div>

<!-- Stats Metric Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center">
        <div class="p-3 rounded-3 me-3" style="background-color: var(--color-primary-light); color: var(--color-primary);">
          <i class="bi bi-file-earmark-text fs-3"></i>
        </div>
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Resources</span>
          <h3 class="fw-bold mb-0"><%= stats.resources %></h3>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center">
        <div class="p-3 rounded-3 me-3" style="background-color: var(--color-success-bg); color: #065F46;">
          <i class="bi bi-book fs-3"></i>
        </div>
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Subjects</span>
          <h3 class="fw-bold mb-0"><%= stats.subjects %></h3>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center">
        <div class="p-3 rounded-3 me-3" style="background-color: var(--color-warning-bg); color: #92400E;">
          <i class="bi bi-calendar3 fs-3"></i>
        </div>
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Semesters</span>
          <h3 class="fw-bold mb-0"><%= stats.semesters %></h3>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center">
        <div class="p-3 rounded-3 me-3" style="background-color: var(--color-primary-light); color: var(--color-accent);">
          <i class="bi bi-envelope-exclamation fs-3"></i>
        </div>
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Unread Inbox</span>
          <h3 class="fw-bold mb-0"><%= stats.unreadFeedback + stats.unreadContact %></h3>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Actions & Recent Uploads -->
<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="fw-bold mb-0">Recent Uploads</h4>
        <a href="/admin/resources" class="btn btn-outline-primary btn-sm">View All</a>
      </div>
      <div class="card-body p-0">
        <% if (recentUploads && recentUploads.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">Title</th>
                  <th>Subject</th>
                  <th>Type</th>
                  <th>Date</th>
                  <th class="text-end pe-3">Action</th>
                </tr>
              </thead>
              <tbody>
                <% recentUploads.forEach(function(r) { %>
                  <tr>
                    <td class="ps-3 fw-semibold"><%= r.title %></td>
                    <td><%= r.subject_name %></td>
                    <td><span class="badge badge-soft-primary"><%= r.type_name %></span></td>
                    <td class="text-secondary small"><%= new Date(r.uploaded_at).toLocaleDateString() %></td>
                    <td class="text-end pe-3">
                      <a href="/resources/<%= r.resource_id %>/download" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-download"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-4 text-center text-secondary">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
            <p class="mb-0">No resources uploaded yet.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card mb-4">
      <div class="card-header">
        <h4 class="fw-bold mb-0">Quick Management</h4>
      </div>
      <div class="list-group list-group-flush" style="border-radius: var(--radius-card);">
        <a href="/admin/semesters" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" style="border-color: var(--color-border);">
          <div><i class="bi bi-calendar3 me-2" style="color: var(--color-primary);"></i> Semesters</div>
          <i class="bi bi-chevron-right text-muted"></i>
        </a>
        <a href="/admin/subjects" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" style="border-color: var(--color-border);">
          <div><i class="bi bi-book me-2" style="color: var(--color-primary);"></i> Subjects & Codes</div>
          <i class="bi bi-chevron-right text-muted"></i>
        </a>
        <a href="/admin/modules" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" style="border-color: var(--color-border);">
          <div><i class="bi bi-collection me-2" style="color: var(--color-primary);"></i> Syllabus Modules</div>
          <i class="bi bi-chevron-right text-muted"></i>
        </a>
        <a href="/admin/announcements" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" style="border-color: var(--color-border);">
          <div><i class="bi bi-megaphone me-2" style="color: var(--color-primary);"></i> Broadcast Announcements</div>
          <i class="bi bi-chevron-right text-muted"></i>
        </a>
      </div>
    </div>
  </div>
</div>
