<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Modules</h2>
    <p class="text-muted mb-0">Manage course modules and unit breakdown under each subject</p>
  </div>
  <% if (selectedSubjectId) { %>
    <a href="/admin/modules/new?subject_id=<%= selectedSubjectId %>" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Add Module
    </a>
  <% } %>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3 bg-white">
    <form method="GET" action="/admin/modules" class="row g-3 align-items-center">
      <div class="col-auto">
        <label for="filterSubject" class="form-label mb-0 fw-semibold">Filter by Subject:</label>
      </div>
      <div class="col-md-5">
        <select class="form-select" id="filterSubject" name="subject_id" onchange="this.form.submit()">
          <% subjects.forEach(function(s) { %>
            <option value="<%= s.subject_id %>" <%= selectedSubjectId == s.subject_id ? 'selected' : '' %>>
              [<%= s.code %>] <%= s.name %> (<%= s.semester_name %>)
            </option>
          <% }); %>
        </select>
      </div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (modules && modules.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3" style="width: 120px;">Unit #</th>
              <th>Module Title</th>
              <th>Description</th>
              <th>Resources</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% modules.forEach(function(m) { %>
              <tr>
                <td class="ps-3">
                  <span class="badge bg-primary text-white">Module <%= m.module_number %></span>
                </td>
                <td class="fw-semibold"><%= m.title %></td>
                <td class="text-muted small"><%= m.description || '—' %></td>
                <td><span class="badge bg-light text-dark border"><%= m.resource_count %> items</span></td>
                <td>
                  <div class="d-flex gap-2">
                    <a href="/admin/modules/<%= m.module_id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/admin/modules/<%= m.module_id %>/delete" method="POST" onsubmit="return confirm('Delete module <%= m.title %>? This will fail if resources are attached.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-4 text-center text-muted">
        <p class="mb-2">No modules found for this subject.</p>
        <% if (selectedSubjectId) { %>
          <a href="/admin/modules/new?subject_id=<%= selectedSubjectId %>" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add the First Module
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

