<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0"><%= isEdit ? 'Edit Module' : 'Add New Module' %></h5>
      </div>
      <div class="card-body p-4">
        <form action="<%= isEdit ? '/admin/modules/' + moduleItem.module_id + '/edit' : '/admin/modules/new' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <% if (!isEdit) { %>
            <div class="mb-3">
              <label for="subject_id" class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
              <select class="form-select" id="subject_id" name="subject_id" required>
                <% subjects.forEach(function(s) { %>
                  <option value="<%= s.subject_id %>" <%= moduleItem.subject_id == s.subject_id ? 'selected' : '' %>>
                    [<%= s.code %>] <%= s.name %>
                  </option>
                <% }); %>
              </select>
            </div>
          <% } else { %>
            <div class="mb-3">
              <label class="form-label fw-semibold text-muted">Subject</label>
              <input type="text" class="form-control bg-light" value="[<%= moduleItem.subject_code %>] <%= moduleItem.subject_name %>" disabled>
            </div>
          <% } %>

          <div class="mb-3">
            <label for="module_number" class="form-label fw-semibold">Module Number <span class="text-danger">*</span></label>
            <input type="number" class="form-control" id="module_number" name="module_number" required min="1" max="20" value="<%= moduleItem.module_number || 1 %>">
            <div class="form-text">e.g. 1 for Module 1, 2 for Module 2.</div>
          </div>

          <div class="mb-3">
            <label for="title" class="form-label fw-semibold">Module Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="title" name="title" required placeholder="e.g. Linear Data Structures - Stacks and Queues" value="<%= moduleItem.title || '' %>">
          </div>

          <div class="mb-4">
            <label for="description" class="form-label fw-semibold">Summary / Syllabus Topics</label>
            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Key topics covered in this module..."><%= moduleItem.description || '' %></textarea>
          </div>

          <div class="d-flex justify-content-between">
            <a href="/admin/modules<%= moduleItem.subject_id ? '?subject_id=' + moduleItem.subject_id : '' %>" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-check-lg me-1"></i> <%= isEdit ? 'Update Module' : 'Save Module' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

