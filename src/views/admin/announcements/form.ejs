<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0"><%= isEdit ? 'Edit Announcement' : 'Post New Announcement' %></h5>
      </div>
      <div class="card-body p-4">
        <form action="<%= isEdit ? '/admin/announcements/' + announcement.announcement_id + '/edit' : '/admin/announcements/new' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="title" name="title" required placeholder="e.g. Mid-term Exam Timetable Published" value="<%= announcement.title || '' %>">
          </div>

          <div class="mb-3">
            <label for="body" class="form-label fw-semibold">Announcement Body <span class="text-danger">*</span></label>
            <textarea class="form-control" id="body" name="body" rows="4" required placeholder="Details for students..."><%= announcement.body || '' %></textarea>
          </div>

          <div class="mb-3">
            <label for="expires_at" class="form-label fw-semibold">Expiry Date (Optional)</label>
            <input type="date" class="form-control" id="expires_at" name="expires_at" value="<%= announcement.expires_at ? announcement.expires_at.slice(0, 10) : '' %>">
            <div class="form-text">Announcements past this date are automatically hidden from students.</div>
          </div>

          <% if (isEdit) { %>
            <div class="form-check form-switch mb-4">
              <input class="form-check-input" type="checkbox" id="is_active" name="is_active" <%= announcement.is_active ? 'checked' : '' %>>
              <label class="form-check-label fw-semibold" for="is_active">Publish on public board</label>
            </div>
          <% } %>

          <div class="d-flex justify-content-between">
            <a href="/admin/announcements" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-check-lg me-1"></i> <%= isEdit ? 'Update Announcement' : 'Publish Announcement' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

