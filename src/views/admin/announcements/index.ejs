<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Announcements</h2>
    <p class="text-muted mb-0">Publish notices with automated expiry handling</p>
  </div>
  <a href="/admin/announcements/new" class="btn btn-primary">
    <i class="bi bi-megaphone me-1"></i> Post Announcement
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (announcements && announcements.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Title & Content</th>
              <th>Status</th>
              <th>Posted Date</th>
              <th>Expiry Date</th>
              <th class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% announcements.forEach(function(a) { %>
              <tr>
                <td class="ps-3" style="max-width: 350px;">
                  <div class="fw-bold text-dark"><%= a.title %></div>
                  <div class="text-muted small text-truncate"><%= a.body %></div>
                </td>
                <td>
                  <% if (a.is_active && (!a.expires_at || new Date(a.expires_at) > new Date())) { %>
                    <span class="badge bg-success-subtle text-success-emphasis">Active</span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Expired / Inactive</span>
                  <% } %>
                </td>
                <td class="text-muted small"><%= new Date(a.created_at).toLocaleDateString() %></td>
                <td class="text-muted small">
                  <%= a.expires_at ? new Date(a.expires_at).toLocaleDateString() : 'Never' %>
                </td>
                <td class="text-end pe-3">
                  <div class="d-flex justify-content-end gap-2">
                    <a href="/admin/announcements/<%= a.announcement_id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/admin/announcements/<%= a.announcement_id %>/delete" method="POST" onsubmit="return confirm('Delete announcement?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-4 text-center text-muted">
        <p class="mb-0">No announcements posted yet.</p>
      </div>
    <% } %>
  </div>
</div>

