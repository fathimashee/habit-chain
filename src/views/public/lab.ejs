<div class="mb-4">
  <h2 class="fw-bold">Laboratory Resources & Practical Code</h2>
  <p class="text-secondary lead">Access lab manuals, experiment problem sets, and code programs categorized by subject.</p>
</div>

<div class="row g-4">
  <!-- Subject Sidebar -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0">Lab Subjects</h5>
      </div>
      <div class="list-group list-group-flush">
        <% if (labSubjects && labSubjects.length > 0) { %>
          <% labSubjects.forEach(function(s) { %>
            <a href="/lab?subject_id=<%= s.subject_id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 <%= selectedSubjectId === s.subject_id ? 'active bg-primary text-white border-primary' : '' %>">
              <div>
                <span class="badge <%= selectedSubjectId === s.subject_id ? 'bg-light text-primary' : 'bg-secondary-subtle text-secondary-emphasis' %> font-monospace me-2"><%= s.code %></span>
                <span class="fw-semibold"><%= s.name %></span>
              </div>
              <i class="bi bi-chevron-right <%= selectedSubjectId === s.subject_id ? 'text-white' : 'text-muted' %>"></i>
            </a>
          <% }); %>
        <% } else { %>
          <div class="p-4 text-center text-muted">No lab courses registered.</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Resources List -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">
          <%= currentSubject ? currentSubject.name + ' - Practical Materials' : 'Lab Materials' %>
        </h5>
        <span class="badge bg-light text-dark border"><%= labResources.length %> items</span>
      </div>
      <div class="card-body p-0">
        <% if (labResources && labResources.length > 0) { %>
          <div class="list-group list-group-flush">
            <% labResources.forEach(function(r) { %>
              <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div class="d-flex align-items-center">
                  <% if (r.file_format === 'pdf') { %>
                    <i class="bi bi-file-earmark-pdf fs-2 text-danger me-3"></i>
                  <% } else if (['zip'].includes(r.file_format)) { %>
                    <i class="bi bi-file-earmark-zip fs-2 text-warning me-3"></i>
                  <% } else { %>
                    <i class="bi bi-file-earmark-code fs-2 text-success me-3"></i>
                  <% } %>
                  <div>
                    <h6 class="fw-bold mb-1"><%= r.title %></h6>
                    <div class="d-flex gap-2 align-items-center">
                      <span class="badge badge-soft-primary"><%= r.type_name %></span>
                      <span class="badge bg-light text-dark border font-monospace small">.<%= r.file_format %></span>
                      <span class="text-muted small"><%= (r.file_size / (1024 * 1024)).toFixed(2) %> MB</span>
                    </div>
                  </div>
                </div>
                <div class="d-flex gap-2">
                  <% if (r.file_format === 'pdf') { %>
                    <a href="/resources/<%= r.resource_id %>/view" class="btn btn-outline-primary btn-sm">
                      <i class="bi bi-eye me-1"></i> Preview
                    </a>
                  <% } %>
                  <a href="/resources/<%= r.resource_id %>/download" class="btn btn-primary btn-sm">
                    <i class="bi bi-download me-1"></i> Download
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="p-5 text-center text-muted">
            <i class="bi bi-code-slash fs-1 d-block mb-2"></i>
            <p class="mb-0">No lab manuals or source files uploaded for this subject yet.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

