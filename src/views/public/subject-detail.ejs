<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/" class="text-decoration-none"><i class="bi bi-house-door"></i> Home</a></li>
    <li class="breadcrumb-item"><a href="/semesters" class="text-decoration-none">Semesters</a></li>
    <li class="breadcrumb-item"><a href="/semesters/<%= semester.semester_id %>" class="text-decoration-none"><%= semester.name %></a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= subject.code %></li>
  </ol>
</nav>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-4">
    <div class="d-flex align-items-center mb-2">
      <span class="badge bg-primary text-white font-monospace fs-6 px-3 py-1 me-2"><%= subject.code %></span>
      <span class="badge bg-light text-secondary border"><%= semester.name %></span>
    </div>
    <h2 class="fw-bold mb-2"><%= subject.name %></h2>
    <p class="text-muted mb-0"><%= subject.description || 'Access syllabus modules, previous year question papers, and lab manuals.' %></p>
  </div>
</div>

<!-- Tabs for Modules, Question Papers, and Lab Manuals -->
<ul class="nav nav-tabs nav-fill mb-4" id="subjectTab" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active fw-bold py-3" id="modules-tab" data-bs-toggle="tab" data-bs-target="#modules-content" type="button" role="tab">
      <i class="bi bi-collection me-2"></i> Syllabus Modules (<%= modules.length %>)
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-bold py-3" id="papers-tab" data-bs-toggle="tab" data-bs-target="#papers-content" type="button" role="tab">
      <i class="bi bi-file-earmark-check me-2"></i> Question Papers (<%= questionPapers.length %>)
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-bold py-3" id="labs-tab" data-bs-toggle="tab" data-bs-target="#labs-content" type="button" role="tab">
      <i class="bi bi-code-slash me-2"></i> Lab Resources (<%= labResources.length %>)
    </button>
  </li>
</ul>

<div class="tab-content" id="subjectTabContent">
  <!-- Modules Tab -->
  <div class="tab-pane fade show active" id="modules-content" role="tabpanel">
    <div class="row g-3">
      <% if (modules && modules.length > 0) { %>
        <% modules.forEach(function(m) { %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 card-hover">
              <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-primary-subtle text-primary-emphasis fw-bold">Module <%= m.module_number %></span>
                  <span class="badge bg-light text-secondary border"><%= m.resource_count %> files</span>
                </div>
                <h5 class="fw-bold text-dark mb-1"><%= m.title %></h5>
                <p class="text-muted small flex-grow-1"><%= m.description || 'Topic materials and reference notes.' %></p>
                <div class="mt-3">
                  <a href="/modules/<%= m.module_id %>" class="btn btn-outline-primary btn-sm w-100 fw-semibold stretched-link">
                    Open Module Notes <i class="bi bi-chevron-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center text-muted py-4">
          <p class="mb-0">No modules registered for this subject yet.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Question Papers Tab -->
  <div class="tab-pane fade" id="papers-content" role="tabpanel">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% if (questionPapers && questionPapers.length > 0) { %>
          <div class="list-group list-group-flush">
            <% questionPapers.forEach(function(p) { %>
              <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div class="d-flex align-items-center">
                  <i class="bi bi-file-earmark-pdf fs-3 text-danger me-3"></i>
                  <div>
                    <h6 class="fw-bold mb-1"><%= p.title %></h6>
                    <span class="badge bg-warning-subtle text-warning-emphasis me-2"><%= p.exam_year || 'University' %></span>
                    <span class="text-muted small"><%= (p.file_size / (1024 * 1024)).toFixed(2) %> MB • <%= p.original_filename %></span>
                  </div>
                </div>
                <div class="d-flex gap-2">
                  <% if (p.file_format === 'pdf') { %>
                    <a href="/resources/<%= p.resource_id %>/view" class="btn btn-outline-primary btn-sm">
                      <i class="bi bi-eye me-1"></i> View
                    </a>
                  <% } %>
                  <a href="/resources/<%= p.resource_id %>/download" class="btn btn-primary btn-sm">
                    <i class="bi bi-download me-1"></i> Download
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center text-muted p-5">
            <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
            <p class="mb-0">No question papers uploaded for this subject yet.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Lab Resources Tab -->
  <div class="tab-pane fade" id="labs-content" role="tabpanel">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% if (labResources && labResources.length > 0) { %>
          <div class="list-group list-group-flush">
            <% labResources.forEach(function(l) { %>
              <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div class="d-flex align-items-center">
                  <i class="bi bi-file-code fs-3 text-success me-3"></i>
                  <div>
                    <h6 class="fw-bold mb-1"><%= l.title %></h6>
                    <span class="badge badge-soft-primary me-2"><%= l.type_name %></span>
                    <span class="text-muted small"><%= (l.file_size / (1024 * 1024)).toFixed(2) %> MB • .<%= l.file_format %></span>
                  </div>
                </div>
                <div class="d-flex gap-2">
                  <% if (l.file_format === 'pdf') { %>
                    <a href="/resources/<%= l.resource_id %>/view" class="btn btn-outline-primary btn-sm">
                      <i class="bi bi-eye me-1"></i> View
                    </a>
                  <% } %>
                  <a href="/resources/<%= l.resource_id %>/download" class="btn btn-primary btn-sm">
                    <i class="bi bi-download me-1"></i> Download
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center text-muted p-5">
            <i class="bi bi-code-slash fs-2 d-block mb-2"></i>
            <p class="mb-0">No lab manuals or programs uploaded for this subject yet.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

