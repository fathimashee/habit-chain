<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
    <li class="breadcrumb-item"><a href="/subjects/<%= resource.subject_id %>" class="text-decoration-none"><%= resource.subject_code %></a></li>
    <% if (resource.module_id) { %>
      <li class="breadcrumb-item"><a href="/modules/<%= resource.module_id %>" class="text-decoration-none">Module <%= resource.module_number %></a></li>
    <% } %>
    <li class="breadcrumb-item active" aria-current="page">PDF Preview</li>
  </ol>
</nav>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h4 class="fw-bold mb-1"><%= resource.title %></h4>
      <div class="text-muted small">
        <span class="badge bg-primary me-2"><%= resource.type_name %></span>
        <span><%= resource.original_filename %></span> • 
        <span><%= (resource.file_size / (1024 * 1024)).toFixed(2) %> MB</span>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/resources/<%= resource.resource_id %>/download" class="btn btn-primary fw-semibold">
        <i class="bi bi-download me-1"></i> Download PDF
      </a>
    </div>
  </div>
</div>

<!-- In-browser PDF Preview Container -->
<div class="card border-0 shadow-sm overflow-hidden">
  <div class="card-body p-0" id="pdf-viewer-wrap">
    <!-- Try native browser embed first -->
    <iframe
      id="pdf-frame"
      src="/resources/<%= resource.resource_id %>/stream"
      class="pdf-viewer-frame"
      title="PDF Preview"
      style="border:none;"
    ></iframe>

    <!-- Friendly fallback shown by JS if iframe fails to load -->
    <div id="pdf-fallback" class="p-5 text-center text-muted d-none">
      <i class="bi bi-file-earmark-pdf fs-1 d-block mb-3 text-danger"></i>
      <h5 class="fw-semibold mb-2">Preview unavailable</h5>
      <p class="mb-1 text-muted small">The file may not yet be available on this server, or your browser blocked the preview.</p>
      <p class="mb-4 text-muted small">Use the <strong>Download PDF</strong> button above to save and open it locally.</p>
      <a href="/resources/<%= resource.resource_id %>/download" class="btn btn-primary">
        <i class="bi bi-download me-1"></i> Download &amp; Open PDF
      </a>
    </div>
  </div>
</div>

<script>
  (function () {
    const frame = document.getElementById('pdf-frame');
    const fallback = document.getElementById('pdf-fallback');

    function showFallback() {
      frame.classList.add('d-none');
      fallback.classList.remove('d-none');
    }

    // Detect load failure: if iframe src returns non-2xx, switch to fallback
    frame.addEventListener('load', function () {
      try {
        // If the server returned a non-PDF error page, content-type check via fetch
        fetch('/resources/<%= resource.resource_id %>/stream', { method: 'HEAD' })
          .then(r => { if (!r.ok) showFallback(); })
          .catch(showFallback);
      } catch (e) { /* cross-origin – assume ok */ }
    });

    frame.addEventListener('error', showFallback);

    // Safety net: if nothing loaded after 6 s, show fallback
    setTimeout(function () {
      if (fallback.classList.contains('d-none') && frame.contentDocument) {
        try {
          const body = frame.contentDocument.body;
          if (!body || body.innerHTML.trim() === '') showFallback();
        } catch (e) { /* cross-origin */ }
      }
    }, 6000);
  })();
</script>

