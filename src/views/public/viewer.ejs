<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
    <li class="breadcrumb-item"><a href="/subjects/<%= resource.subject_id %>" class="text-decoration-none"><%= resource.subject_code %></a></li>
    <% if (resource.module_id) { %>
      <li class="breadcrumb-item"><a href="/modules/<%= resource.module_id %>" class="text-decoration-none">Module <%= resource.module_number %></a></li>
    <% } %>
    <li class="breadcrumb-item active" aria-current="page">PDF Preview</li>
  </ol>
</nav>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h4 class="fw-bold mb-1"><%= resource.title %></h4>
      <div class="text-muted small">
        <span class="badge bg-primary me-2"><%= resource.type_name %></span>
        <span><%= resource.original_filename %></span> • 
        <span><%= (resource.file_size / (1024 * 1024)).toFixed(2) %> MB</span>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/resources/<%= resource.resource_id %>/download" class="btn btn-primary fw-semibold">
        <i class="bi bi-download me-1"></i> Download PDF
      </a>
    </div>
  </div>
</div>

<!-- In-browser PDF Preview Container -->
<div class="card border-0 shadow-sm overflow-hidden">
  <div class="card-body p-0">
    <object data="/resources/<%= resource.resource_id %>/stream" type="application/pdf" class="pdf-viewer-frame">
      <div class="p-5 text-center text-muted">
        <i class="bi bi-file-earmark-pdf fs-1 d-block mb-3 text-danger"></i>
        <h5>Unable to render PDF directly in this browser frame.</h5>
        <p class="mb-4">You can download or view the PDF document using your browser's dedicated viewer.</p>
        <a href="/resources/<%= resource.resource_id %>/download" class="btn btn-primary">
          <i class="bi bi-download me-1"></i> Download File
        </a>
      </div>
    </object>
  </div>
</div>

