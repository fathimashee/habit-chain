<div class="container py-5 text-center">
  <div class="display-1 text-danger fw-bold mb-3">500</div>
  <h2 class="fw-bold mb-2">Internal Server Error</h2>
  <p class="text-muted mb-4 lead">Something went wrong while processing your request. Please try again shortly.</p>
  <% if (typeof error !== 'undefined' && error && error.message) { %>
    <div class="alert alert-danger text-start mx-auto p-3 font-monospace small" style="max-width: 600px;">
      <%= error.message %>
    </div>
  <% } %>
  <a href="/" class="btn btn-primary px-4 py-2">
    <i class="bi bi-house-door me-1"></i> Return to Home
  </a>
</div>

