<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card p-4">
      <div class="mb-4">
        <h2 class="fw-bold mb-1">Student Feedback</h2>
        <p class="text-secondary small mb-0">Share suggestions, report missing notes, or notify administrators about platform issues.</p>
      </div>

      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger mb-4">
          <ul class="mb-0 ps-3">
            <% errors.forEach(function(e) { %>
              <li><%= e.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/feedback" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="name" class="form-label fw-semibold">Your Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="name" name="name" required placeholder="Student Name" value="<%= formData.name || '' %>">
          </div>
          <div class="col-md-6">
            <label for="email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="email" name="email" required placeholder="student@college.edu" value="<%= formData.email || '' %>">
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="category" class="form-label fw-semibold">Feedback Category <span class="text-danger">*</span></label>
            <select class="form-select" id="category" name="category" required>
              <option value="content" <%= formData.category === 'content' ? 'selected' : '' %>>Course Content / Missing Notes</option>
              <option value="bug" <%= formData.category === 'bug' ? 'selected' : '' %>>Bug or Error Report</option>
              <option value="suggestion" <%= formData.category === 'suggestion' ? 'selected' : '' %>>Feature Suggestion</option>
              <option value="other" <%= formData.category === 'other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="rating" class="form-label fw-semibold">Platform Rating (Optional)</label>
            <select class="form-select" id="rating" name="rating">
              <option value="">-- Rate (1 to 5) --</option>
              <option value="5" <%= formData.rating == '5' ? 'selected' : '' %>>⭐⭐⭐⭐⭐ (Excellent)</option>
              <option value="4" <%= formData.rating == '4' ? 'selected' : '' %>>⭐⭐⭐⭐ (Good)</option>
              <option value="3" <%= formData.rating == '3' ? 'selected' : '' %>>⭐⭐⭐ (Average)</option>
              <option value="2" <%= formData.rating == '2' ? 'selected' : '' %>>⭐⭐ (Poor)</option>
              <option value="1" <%= formData.rating == '1' ? 'selected' : '' %>>⭐ (Very Poor)</option>
            </select>
          </div>
        </div>

        <div class="mb-4">
          <label for="message" class="form-label fw-semibold">Your Message <span class="text-danger">*</span></label>
          <textarea class="form-control" id="message" name="message" rows="5" required placeholder="Provide details regarding notes, errors, or feedback..."><%= formData.message || '' %></textarea>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <span class="text-secondary small">All submissions are reviewed by Habit Chain administrators.</span>
          <button type="submit" class="btn btn-primary px-4 fw-semibold">
            <i class="bi bi-send me-1"></i> Send Feedback
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
