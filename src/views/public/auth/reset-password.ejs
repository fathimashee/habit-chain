<!-- Reset Password – Habit Chain -->
<div class="d-flex min-vh-100 align-items-center justify-content-center">
  <div class="auth-card px-2">

    <div class="text-center mb-4">
      <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
        <%- include('../../partials/logo') %>
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:700;color:var(--color-text)">Habit Chain</span>
      </a>
    </div>

    <h1>Set a new password</h1>
    <p class="auth-subtitle">Choose a strong password you haven't used before.</p>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="auth-alert auth-alert-error" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div><%= errors[0].msg %></div>
      </div>
    <% } %>

    <form method="POST" action="/reset-password/<%= token %>" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-2">
        <label for="password" class="form-label">New Password</label>
        <div class="pwd-wrapper">
          <input type="password" id="password" name="password" class="form-control"
            autocomplete="new-password" required minlength="8" autofocus>
          <button type="button" class="pwd-toggle" onclick="togglePwd('password','icon1')" aria-label="Show/hide password">
            <i class="bi bi-eye" id="icon1"></i>
          </button>
        </div>
        <div class="strength-meter mt-2"><div class="strength-meter-bar" id="strengthBar"></div></div>
        <div class="strength-label" id="strengthLabel">Minimum 8 characters with a letter and number</div>
      </div>

      <div class="mb-4">
        <label for="confirm_password" class="form-label">Confirm New Password</label>
        <div class="pwd-wrapper">
          <input type="password" id="confirm_password" name="confirm_password" class="form-control"
            autocomplete="new-password" required>
          <button type="button" class="pwd-toggle" onclick="togglePwd('confirm_password','icon2')" aria-label="Show/hide confirm">
            <i class="bi bi-eye" id="icon2"></i>
          </button>
        </div>
        <div class="form-text" id="matchHint"></div>
      </div>

      <button type="submit" class="btn-auth">Reset Password</button>
    </form>
  </div>
</div>

<script>
function togglePwd(fieldId, iconId) {
  const f = document.getElementById(fieldId);
  const i = document.getElementById(iconId);
  f.type = f.type === 'password' ? 'text' : 'password';
  i.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}
const pwdInput = document.getElementById('password');
const bar = document.getElementById('strengthBar');
const lbl = document.getElementById('strengthLabel');
pwdInput.addEventListener('input', () => {
  const v = pwdInput.value;
  let s = 0;
  if (v.length >= 8) s++;
  if (/[a-zA-Z]/.test(v)) s++;
  if (/[0-9]/.test(v)) s++;
  if (/[^a-zA-Z0-9]/.test(v)) s++;
  if (v.length >= 12) s++;
  bar.style.width = (s / 5 * 100) + '%';
  if (s <= 1) { bar.style.background = '#E11D48'; lbl.textContent = 'Very weak'; }
  else if (s === 2) { bar.style.background = '#D97706'; lbl.textContent = 'Weak'; }
  else if (s === 3) { bar.style.background = '#10B981'; lbl.textContent = 'Good'; }
  else { bar.style.background = '#0F9D9A'; lbl.textContent = 'Strong'; }
});
const cpwd = document.getElementById('confirm_password');
const matchHint = document.getElementById('matchHint');
cpwd.addEventListener('input', () => {
  if (cpwd.value === pwdInput.value) {
    matchHint.textContent = '✓ Passwords match'; matchHint.style.color = '#0F9D9A';
  } else {
    matchHint.textContent = 'Passwords do not match'; matchHint.style.color = '#E11D48';
  }
});
</script>

