<!-- Forgot Password – Habit Chain -->
<div class="d-flex min-vh-100 align-items-center justify-content-center">
  <div class="auth-card px-2">

    <div class="text-center mb-4">
      <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
        <%- include('../../partials/logo') %>
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:700;color:var(--color-text)">Habit Chain</span>
      </a>
    </div>

    <% if (sent) { %>
      <div class="auth-alert auth-alert-success" role="status">
        <i class="bi bi-envelope-check-fill mt-1"></i>
        <div>
          <strong>Check your inbox.</strong><br>
          If that email is registered, we've sent a password reset link. It expires in 30 minutes.
        </div>
      </div>
      <p class="text-center mt-3 mb-0" style="font-size:.9rem">
        <a href="/login" class="auth-link">← Back to Log In</a>
      </p>
    <% } else { %>
      <h1>Forgot your password?</h1>
      <p class="auth-subtitle">Enter your email and we'll send a reset link.</p>

      <% const flash = typeof messages !== 'undefined' && messages.error && messages.error[0]; %>
      <% if (flash) { %>
        <div class="auth-alert auth-alert-error" role="alert" aria-live="assertive">
          <i class="bi bi-exclamation-triangle-fill mt-1"></i>
          <div><%= flash %></div>
        </div>
      <% } %>

      <form method="POST" action="/forgot-password" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-4">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" autofocus required autocomplete="email">
        </div>
        <button type="submit" class="btn-auth">Send Reset Link</button>
      </form>

      <p class="text-center mt-3 mb-0" style="font-size:.9rem">
        <a href="/login" class="auth-link">← Back to Log In</a>
      </p>
    <% } %>
  </div>
</div>

