<!-- Login Page – Habit Chain -->
<div class="auth-split">

  <!-- Left: Teal Benefit Panel -->
  <aside class="auth-panel">
    <a href="/" class="brand-logo">
      <%- include('../../partials/logo') %>
      <span class="brand-name">Habit Chain</span>
    </a>
    <p class="brand-tagline">Your chain of consistent learning, all in one place.</p>
    <ul class="benefit-list">
      <li><i class="bi bi-journals"></i> Organised notes and study materials</li>
      <li><i class="bi bi-patch-question-fill"></i> Previous year question papers by subject</li>
      <li><i class="bi bi-share-fill"></i> Contribute your notes and earn credit</li>
    </ul>
  </aside>

  <!-- Right: Form -->
  <div class="auth-form-side">
    <div class="auth-card">

      <!-- Mobile-only logo -->
      <div class="auth-logo-mobile">
        <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
          <%- include('../../partials/logo') %>
          <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:700;color:var(--color-text)">Habit Chain</span>
        </a>
      </div>

      <h1>Welcome back</h1>
      <p class="auth-subtitle">Log in to your Habit Chain account.</p>

      <!-- Error messages -->
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="auth-alert auth-alert-error" role="alert" aria-live="assertive">
          <i class="bi bi-exclamation-triangle-fill mt-1"></i>
          <div><%= errors[0].msg %></div>
        </div>
      <% } %>

      <% const flash = typeof messages !== 'undefined' && messages.error && messages.error[0]; %>
      <% if (flash) { %>
        <div class="auth-alert auth-alert-error" role="alert" aria-live="assertive">
          <i class="bi bi-exclamation-triangle-fill mt-1"></i>
          <div><%= flash %></div>
        </div>
      <% } %>

      <% const flashSuccess = typeof messages !== 'undefined' && messages.success && messages.success[0]; %>
      <% if (flashSuccess) { %>
        <div class="auth-alert auth-alert-success" role="status" aria-live="polite">
          <i class="bi bi-check-circle-fill mt-1"></i>
          <div><%= flashSuccess %></div>
        </div>
      <% } %>

      <form method="POST" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (typeof nextUrl !== 'undefined' && nextUrl) { %>
          <input type="hidden" name="next" value="<%= nextUrl %>">
        <% } %>

        <!-- Email -->
        <div class="mb-3">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" autocomplete="email"
            autofocus required value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>">
        </div>

        <!-- Password -->
        <div class="mb-2">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="password" class="form-label mb-0">Password</label>
            <a href="/forgot-password" class="auth-link" style="font-size:.85rem">Forgot password?</a>
          </div>
          <div class="pwd-wrapper">
            <input type="password" id="password" name="password" class="form-control"
              autocomplete="current-password" required>
            <button type="button" class="pwd-toggle" onclick="togglePwd()" aria-label="Show/hide password">
              <i class="bi bi-eye" id="pwdIcon"></i>
            </button>
          </div>
        </div>

        <!-- Remember me -->
        <div class="mb-4 form-check">
          <input type="checkbox" class="form-check-input" id="remember_me" name="remember_me" value="1">
          <label class="form-check-label" for="remember_me" style="font-size:.9rem">Remember me for 30 days</label>
        </div>

        <button type="submit" class="btn-auth" id="loginBtn">
          <span id="btnText">Log In</span>
          <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
        </button>
      </form>

      <div class="auth-divider">or</div>

      <p class="text-center mb-1" style="font-size:.9rem">
        Don't have an account? <a href="/signup" class="auth-link">Sign up — it's free</a>
      </p>
      <a href="/" class="auth-guest">Continue browsing as guest →</a>
    </div>
  </div>
</div>

<script>
function togglePwd() {
  const f = document.getElementById('password');
  const i = document.getElementById('pwdIcon');
  f.type = f.type === 'password' ? 'text' : 'password';
  i.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}

document.querySelector('form').addEventListener('submit', () => {
  document.getElementById('btnText').textContent = 'Logging in…';
  document.getElementById('btnSpinner').classList.remove('d-none');
  document.getElementById('loginBtn').disabled = true;
});
</script>

