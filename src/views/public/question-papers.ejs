<div class="mb-4">
  <h2 class="fw-bold">Previous Year Question Papers</h2>
  <p class="text-secondary lead">University examination question papers organized by subject and exam year.</p>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3 bg-white">
    <form method="GET" action="/question-papers" class="row g-3 align-items-center">
      <div class="col-md-5">
        <label for="filterSubject" class="form-label small text-muted mb-1">Filter by Subject</label>
        <select class="form-select" id="filterSubject" name="subject_id" onchange="this.form.submit()">
          <option value="">-- All Subjects --</option>
          <% subjects.forEach(function(s) { %>
            <option value="<%= s.subject_id %>" <%= selectedSubjectId == s.subject_id ? 'selected' : '' %>>
              [<%= s.code %>] <%= s.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="filterYear" class="form-label small text-muted mb-1">Filter by Year</label>
        <select class="form-select" id="filterYear" name="year" onchange="this.form.submit()">
          <option value="">-- All Years --</option>
          <% [2026, 2025, 2024, 2023, 2022, 2021, 2020].forEach(function(yr) { %>
            <option value="<%= yr %>" <%= selectedYear == yr ? 'selected' : '' %>><%= yr %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-3 d-flex align-items-end">
        <a href="/question-papers" class="btn btn-outline-secondary w-100">Reset Filters</a>
      </div>
    </form>
  </div>
</div>

<!-- Question Papers Grouped By Year -->
<% if (Object.keys(papersByYear).length > 0) { %>
  <% Object.keys(papersByYear).sort((a,b) => b - a).forEach(function(yearKey) { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-primary">
          <i class="bi bi-calendar-event me-2"></i> Examination Year: <%= yearKey %>
        </h5>
        <span class="badge bg-light text-dark border"><%= papersByYear[yearKey].length %> papers</span>
      </div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% papersByYear[yearKey].forEach(function(p) { %>
            <div class="list-group-item d-flex justify-content-between align-items-center p-3">
              <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-pdf fs-2 text-danger me-3"></i>
                <div>
                  <h6 class="fw-bold mb-1"><%= p.title %></h6>
                  <span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace me-2"><%= p.subject_code %></span>
                  <span class="text-muted small"><%= p.subject_name %> • <%= (p.file_size / (1024 * 1024)).toFixed(2) %> MB</span>
                </div>
              </div>
              <div class="d-flex gap-2">
                <% if (p.file_format === 'pdf') { %>
                  <a href="/resources/<%= p.resource_id %>/view" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-eye me-1"></i> Preview
                  </a>
                <% } %>
                <a href="/resources/<%= p.resource_id %>/download" class="btn btn-primary btn-sm">
                  <i class="bi bi-download me-1"></i> Download
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  <% }); %>
<% } else { %>
  <div class="card border-0 shadow-sm p-5 text-center text-muted">
    <i class="bi bi-file-earmark-x fs-1 d-block mb-3"></i>
    <h5>No question papers found matching your criteria.</h5>
    <p class="mb-0">Try clearing your filters or check back later.</p>
  </div>
<% } %>

