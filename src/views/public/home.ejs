<!-- Hero Section -->
<div class="hero-chain mb-5 text-center">
  <div class="container-fluid py-2">
    <div class="d-inline-flex p-3 rounded-circle bg-white shadow-sm mb-3 border" style="border-color: var(--color-border) !important;">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0F9D9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
    </div>
    <h1 class="fw-bold mb-2">Habit Chain</h1>
    <p class="tagline mb-4">
      Your chain of consistent learning, all in one place.
    </p>
    <div class="d-flex justify-content-center flex-wrap gap-3 mt-3">
      <a href="/semesters" class="btn btn-primary btn-lg px-4 fw-semibold">
        <i class="bi bi-folder2-open me-2"></i> Browse Semesters
      </a>
      <a href="/question-papers" class="btn btn-outline-primary btn-lg px-4 fw-semibold">
        <i class="bi bi-file-earmark-check me-2"></i> Question Papers
      </a>
    </div>
  </div>
</div>

<!-- Active Announcements Banner -->
<% if (announcements && announcements.length > 0) { %>
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="fw-bold mb-0">
        <i class="bi bi-megaphone-fill me-2" style="color: var(--color-primary);"></i> Latest Announcements
      </h3>
      <a href="/announcements" class="small fw-semibold">View All <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="row g-3">
      <% announcements.forEach(function(a) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-start border-4" style="border-left-color: var(--color-primary) !important;">
            <div class="card-body p-3">
              <span class="badge badge-soft-primary small mb-2">Notice</span>
              <h5 class="fw-bold mb-1"><%= a.title %></h5>
              <p class="text-secondary small mb-2"><%= a.body %></p>
              <div class="text-muted small">
                <i class="bi bi-clock me-1"></i><%= new Date(a.created_at).toLocaleDateString() %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<!-- Fast Navigation Semesters -->
<div class="mb-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">
      <i class="bi bi-calendar3 me-2" style="color: var(--color-primary);"></i> Browse by Semester
    </h3>
    <a href="/semesters" class="small fw-semibold">All Semesters <i class="bi bi-arrow-right"></i></a>
  </div>
  <div class="row g-3">
    <% if (semesters && semesters.length > 0) { %>
      <% semesters.forEach(function(s) { %>
        <div class="col-sm-6 col-md-4 col-lg-3">
          <div class="card card-hover h-100">
            <div class="card-body p-4 text-center">
              <div class="d-inline-flex p-3 rounded-circle mb-3" style="background-color: var(--color-primary-light);">
                <i class="bi bi-folder-fill fs-3" style="color: var(--color-primary);"></i>
              </div>
              <h4 class="fw-bold mb-1"><%= s.name %></h4>
              <p class="text-secondary small mb-3">Syllabus & Course Modules</p>
              <a href="/semesters/<%= s.semester_id %>" class="btn btn-outline-primary btn-sm w-100 stretched-link">
                View Subjects
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<!-- Quick Link Categories -->
<div class="row g-4 mb-5">
  <div class="col-md-6">
    <div class="card p-4 card-hover h-100" style="background: linear-gradient(135deg, #FFFFFF 0%, var(--color-primary-light) 100%);">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h3 class="fw-bold mb-1">Laboratory Resources</h3>
          <p class="mb-3 text-secondary">Lab manuals, sample code, and program experiment write-ups.</p>
          <a href="/lab" class="btn btn-primary btn-sm px-3 fw-semibold">
            Open Lab Section <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
        <i class="bi bi-code-slash display-4 opacity-25 ms-3" style="color: var(--color-primary);"></i>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card p-4 card-hover h-100" style="background: linear-gradient(135deg, #FFFFFF 0%, var(--color-surface) 100%);">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h3 class="fw-bold mb-1">Question Bank & Papers</h3>
          <p class="mb-3 text-secondary">Previous university papers categorized by subject and examination year.</p>
          <a href="/question-papers" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
            Open Question Papers <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
        <i class="bi bi-file-earmark-check display-4 opacity-25 ms-3" style="color: var(--color-accent);"></i>
      </div>
    </div>
  </div>
</div>

<!-- Recently Added Resources -->
<% if (recentResources && recentResources.length > 0) { %>
  <div class="mb-4">
    <h3 class="fw-bold mb-3">
      <i class="bi bi-clock-history me-2" style="color: var(--color-accent);"></i> Recently Added Materials
    </h3>
    <div class="card">
      <div class="card-body p-0">
        <div class="list-group list-group-flush" style="border-radius: var(--radius-card);">
          <% recentResources.forEach(function(r) { %>
            <div class="list-group-item d-flex justify-content-between align-items-center p-3" style="border-color: var(--color-border);">
              <div class="d-flex align-items-center">
                <% if (r.file_format === 'pdf') { %>
                  <i class="bi bi-file-earmark-pdf fs-2 me-3" style="color: var(--color-danger);"></i>
                <% } else { %>
                  <i class="bi bi-file-earmark-text fs-2 me-3" style="color: var(--color-primary);"></i>
                <% } %>
                <div>
                  <h5 class="fw-bold mb-1"><%= r.title %></h5>
                  <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-light text-secondary border font-monospace"><%= r.subject_code %></span>
                    <span class="badge badge-soft-primary"><%= r.type_name %></span>
                    <span class="text-secondary small"><%= (r.file_size / (1024 * 1024)).toFixed(2) %> MB • <%= new Date(r.uploaded_at).toLocaleDateString() %></span>
                  </div>
                </div>
              </div>
              <div class="d-flex gap-2">
                <% if (r.file_format === 'pdf') { %>
                  <a href="/resources/<%= r.resource_id %>/view" class="btn btn-outline-primary btn-sm">Preview</a>
                <% } %>
                <a href="/resources/<%= r.resource_id %>/download" class="btn btn-primary btn-sm">Download</a>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
<% } %>
