<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/" class="text-decoration-none"><i class="bi bi-house-door"></i> Home</a></li>
    <li class="breadcrumb-item"><a href="/semesters" class="text-decoration-none">Semesters</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= semester.name %></li>
  </ol>
</nav>

<div class="mb-4">
  <h2 class="fw-bold"><%= semester.name %> - Subjects</h2>
  <p class="text-secondary lead">Choose a subject below to view syllabus modules, study materials, and practicals.</p>
</div>

<div class="row g-4">
  <% if (subjects && subjects.length > 0) { %>
    <% subjects.forEach(function(s) { %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm card-hover">
          <div class="card-body p-4 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="badge bg-primary text-white font-monospace px-2 py-1"><%= s.code %></span>
              <span class="badge bg-light text-dark border"><%= s.resource_count %> resources</span>
            </div>
            <h5 class="card-title fw-bold text-dark mt-2 mb-1"><%= s.name %></h5>
            <p class="text-muted small flex-grow-1"><%= s.description || 'Core academic syllabus course.' %></p>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
              <span class="text-muted small"><i class="bi bi-collection me-1"></i><%= s.module_count %> Modules</span>
              <a href="/subjects/<%= s.subject_id %>" class="btn btn-primary btn-sm px-3 fw-semibold stretched-link">
                Open Subject <i class="bi bi-chevron-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12 text-center text-muted py-5">
      <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
      <p>No subjects have been registered under <%= semester.name %> yet.</p>
    </div>
  <% } %>
</div>

