<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-bookmark-heart me-2" style="color:var(--color-primary)"></i>My Bookmarks</h1>
    <a href="/semesters" class="btn btn-outline-primary btn-sm">Browse More</a>
  </div>

  <% if (typeof messages !== 'undefined' && messages.success && messages.success[0]) { %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i><%= messages.success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (!bookmarks || bookmarks.length === 0) { %>
    <div class="card border-0 shadow-sm text-center py-5">
      <i class="bi bi-bookmark fs-1 d-block mb-3" style="color:var(--color-primary-light)"></i>
      <p class="text-muted mb-3">No bookmarks yet.</p>
      <a href="/semesters" class="btn btn-primary">Browse Resources</a>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% bookmarks.forEach(b => { %>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge" style="background:var(--color-primary-light);color:var(--color-primary)"><%= b.type_name %></span>
                <form method="POST" action="/student/bookmarks/remove" class="m-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="resource_id" value="<%= b.resource_id %>">
                  <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Remove bookmark">
                    <i class="bi bi-bookmark-x-fill"></i>
                  </button>
                </form>
              </div>
              <h3 class="h6 fw-semibold mb-1">
                <a href="/resources/<%= b.resource_id %>/view" class="text-decoration-none" style="color:var(--color-text)"><%= b.title %></a>
              </h3>
              <p class="text-muted small mb-3"><%= b.subject_code %> – <%= b.subject_name %> • <%= b.semester_name %></p>
              <div class="mt-auto d-flex gap-2">
                <a href="/resources/<%= b.resource_id %>/view" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-eye me-1"></i>View
                </a>
                <a href="/resources/<%= b.resource_id %>/download" class="btn btn-sm btn-primary">
                  <i class="bi bi-download me-1"></i>Download
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

